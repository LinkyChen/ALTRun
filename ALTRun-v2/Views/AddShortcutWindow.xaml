<Window x:Class="ALTRun.Views.AddShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ALTRun.Services"
        Title="{x:Static svc:AppStrings.AddShortcutTitle}"
        Width="580"
        MinWidth="480"
        MinHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontSize="14"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <!-- 初始值；ThemeManager.ApplyTheme 会在窗口加载时覆盖为当前主题配色 -->
        <SolidColorBrush x:Key="WindowBg" Color="#18181C"/>
        <SolidColorBrush x:Key="CardBg" Color="#222228"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#18181C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="BtnBg" Color="#2A2A32"/>
        <SolidColorBrush x:Key="BtnFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#0B1220"/>
        <SolidColorBrush x:Key="HoverBgBrush" Color="#2E3442"/>
        <SolidColorBrush x:Key="HighlightBgBrush" Color="#27374D"/>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource HighlightBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="66"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{x:Static svc:AppStrings.AddShortcutHeader}"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,16"/>

        <!-- 三个输入字段 -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{x:Static svc:AppStrings.LabelShortCut}"/>
            <TextBox x:Name="TxtShortCut" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                     Style="{StaticResource FieldInput}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{x:Static svc:AppStrings.LabelName}"/>
            <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                     Style="{StaticResource FieldInput}" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="{x:Static svc:AppStrings.LabelCommandLine}"/>
            <TextBox x:Name="TxtCommandLine" Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource FieldInput}"/>
            <Button x:Name="BtnBrowse" Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource ModernBtn}"
                    Content="{x:Static svc:AppStrings.BtnBrowseFileShort}"
                    ToolTip="{x:Static svc:AppStrings.TooltipBrowseFile}"
                    Margin="8,0,0,0" Click="BtnBrowse_Click"/>
        </Grid>

        <!-- 参数类型 -->
        <GroupBox Grid.Row="2"
                  Header="{x:Static svc:AppStrings.ParamTypeGroup}"
                  Foreground="{DynamicResource TextSecondary}"
                  BorderBrush="{DynamicResource InputBorder}"
                  BorderThickness="1"
                  Padding="12,10"
                  Margin="0,0,0,10">
            <StackPanel>
                <RadioButton x:Name="RbNoParam" Content="{x:Static svc:AppStrings.ParamTypeNone}"
                             Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,4" IsChecked="True"/>
                <RadioButton x:Name="RbNoEncoding" Content="{x:Static svc:AppStrings.ParamTypeNoEncoding}"
                             Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,4"/>
                <RadioButton x:Name="RbUrlQuery" Content="{x:Static svc:AppStrings.ParamTypeUrlQuery}"
                             Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,4"/>
                <RadioButton x:Name="RbUtf8Query" Content="{x:Static svc:AppStrings.ParamTypeUtf8Query}"
                             Foreground="{DynamicResource TextPrimary}" FontSize="14" Margin="0,4"/>
            </StackPanel>
        </GroupBox>

        <!-- 占位符说明 -->
        <TextBlock Grid.Row="3"
                   Text="{x:Static svc:AppStrings.AddShortcutHint}"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="4,0,4,10"/>

        <!-- 确定 / 取消 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnOk" Style="{StaticResource AccentBtn}"
                    Content="{x:Static svc:AppStrings.BtnOk}" IsDefault="True"
                    MinWidth="100" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Style="{StaticResource ModernBtn}"
                    Content="{x:Static svc:AppStrings.BtnCancel}" IsCancel="True"
                    MinWidth="100" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
