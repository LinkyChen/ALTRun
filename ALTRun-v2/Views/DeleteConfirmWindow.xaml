<Window x:Class="ALTRun.Views.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ALTRun.Services"
        Title="{x:Static svc:AppStrings.DeleteItemTitle}"
        Width="480"
        MinWidth="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="false"
        Topmost="true"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontSize="14"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#18181C"/>
        <SolidColorBrush x:Key="CardBg" Color="#222228"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#35FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#18181C"/>
        <SolidColorBrush x:Key="InputBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="BtnBg" Color="#2A2A32"/>
        <SolidColorBrush x:Key="BtnFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnBorder" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#0B1220"/>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#E5484D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="12,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 条目信息：快捷词 / 名称 / 命令行 -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static svc:AppStrings.LabelShortCut}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Top" Margin="0,0,10,8"/>
                <TextBlock x:Name="TxtShortCut" Grid.Row="0" Grid.Column="1"
                           FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static svc:AppStrings.LabelName}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Top" Margin="0,0,10,8"/>
                <TextBlock x:Name="TxtName" Grid.Row="1" Grid.Column="1"
                           FontSize="14" Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static svc:AppStrings.LabelCommandLine}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Top" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtCommandLine" Grid.Row="2" Grid.Column="1"
                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           FontFamily="Consolas, Cascadia Code, monospace"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 确认提示 -->
        <TextBlock Grid.Row="1" Text="{x:Static svc:AppStrings.DeleteItemTitle}"
                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                   Margin="0,14,0,0"/>

        <!-- 按钮：左删除、右取消 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnDelete"
                    Content="{x:Static svc:AppStrings.DeleteItemButton}"
                    Style="{StaticResource DangerBtn}"
                    Width="104" Height="38"
                    IsDefault="true"
                    Margin="0,0,10,0"
                    Click="BtnDelete_Click"/>
            <Button x:Name="BtnCancel"
                    Content="{x:Static svc:AppStrings.BtnCancel}"
                    Style="{StaticResource SecondaryBtn}"
                    Width="104" Height="38"
                    IsCancel="true"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
